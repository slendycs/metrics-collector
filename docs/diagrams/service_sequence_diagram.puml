@startuml service_sequence_diagram
title Диаграмма последовательности — Сервис сбора метрик (вариант 27: ИБ ИЗ2 ПЗ1 Д1ОЗ3 Д1ОО5 Д2П1 Д2Б4 ОР1 ОД3)
autonumber
skinparam sequenceMessageAlign left

participant "Агент\n(PoolingManager + Client)" as AG
participant "ДП\nСервис приёма\nPOST /collect" as DP
participant "Buffer (DI)\nRedisBuffer + Lua" as BUF
participant "Сервис статистики" as ST
participant "ДВ\nWorkerManager\n(единственный экземпляр)" as DV
participant "Воркер k\nWorker.run" as W
database "БД временных рядов" as DB
participant "PagerDuty" as PD
actor "Оператор" as OP

== Старт ==
DV -> BUF : subscribe(on_buffer_updated)
note over DV : запуск watchdog (раз в watchdog_interval)
W -> DV : POST /register(worker_id, url, priority)
DV -> DV : add_worker(worker)\nсписок упорядочен по priority (Д2П1)
DV --> W : 200 OK
DV -> DV : _try_dispatch() (триггер: новый воркер)

== Триггер А: срабатывание таймера агента (ИБ — бесконечный, ИЗ2 — равномерный интервал) ==
loop пока агент работает
  AG -> AG : collect() → ServerStats\n(server_name, server_type, seq, metrics)
  AG -> DP : POST /collect(ServerStatsDTO)
  DP -> DP : bid = Bid(source_name, source_type,\ntime_in = now, stats), id пока пуст
  DP -> BUF : put(bid, seq)
  note over BUF
    Lua put_bid (атомарно)
    INCR buffer:bid_id — глобальный id (выдаётся всегда)
    seq Redis не считает, его присылает агент
    Д1ОЗ3: первое свободное место от начала, без сдвига
    Блокировки в ДП не нужны, работает при нескольких экземплярах ДП
  end note
  alt есть свободное место (accepted = true)
    BUF --> DP : PutResult(accepted, slot, bid_id, seq)
    BUF -> DV : PUBLISH buffer_updated (триггер Б1)
  else буфер полон — отказ новой заявке (Д1ОО5)
    BUF --> DP : PutResult(accepted = false, slot = None, bid_id, seq)
    note over DP,BUF : буфер и заявки в нём не меняются, выбивания нет;\nпакет потерян, следующий придёт по таймеру агента
  end
  DP -> DP : bid.id = result.bid_id
  alt accepted
    DP ->> ST : POST /webhooks/new(bid, seq, slot)
    note over ST : mark_start(at) при первой заявке, generated += 1
  else отказ
    DP ->> ST : POST /webhooks/new(bid, seq, slot = None)
    DP ->> ST : POST /webhooks/reject(bid, seq)
    note over ST : reject += 1, mark_end(at)
  end
  DP --> AG : 201 Created (PutResultDTO)
  opt сетевая ошибка / 5xx (504 таймаут буфера, 502 нет соединения, 500)
    note over AG,DP : Client бросает Exception, PoolingManager пропускает такт
  end
  AG -> AG : sleep(uniform(timeout_min, timeout_max)) (ИЗ2)
end

== Диспетчеризация ДВ ==
note over DV
  Все триггеры (Б1, Б2, регистрация, watchdog) → один идемпотентный
  _try_dispatch под asyncio.Lock
end note
DV -> DV : on_buffer_updated() / on_worker_free() / add_worker() / watchdog()
loop пока есть свободный воркер и заявка в буфере
  DV -> DV : _get_worker() — первый IDLE по возрастанию priority (Д2П1)
  alt свободных воркеров нет (воркеры не отказывают, они заняты)
    note over DV,BUF : заявки остаются в буфере, цикл завершён, ждём триггер Б2
  else воркер k найден
    DV -> BUF : pull()
    note over BUF
      Lua take_next (атомарно)
      Д2Б4: приоритет по source_type, при равных max(id), слот освобождается
      Номер слота порядок выбора не задаёт
    end note
    alt буфер пуст
      BUF --> DV : None
      note over DV : цикл завершён, воркер k остаётся IDLE, ждём Б1
    else в буфере есть заявка
      BUF --> DV : TakeResult(bid, slot)
      DV -> DV : worker.status = BUSY, current_bid = bid,\ncurrent_slot = slot, started_at = now
      DV -> W : POST /process(BidDTO)
      alt воркер принял заявку
        W --> DV : 202 Accepted
        DV ->> ST : POST /task-status(bid, taken, worker_id, slot, t_ож = now − bid.time_in, at)
      else воркер занят (409) или недоступен (сеть, 5xx)
        W --> DV : 409 Conflict или ответа нет
        DV -> BUF : requeue(bid)
        note over BUF : Lua return_bid — первое свободное место,\nid и time_in сохраняются, без PUBLISH
        alt место в буфере есть
          BUF --> DV : True
          note over DV : заявка снова в очереди, время ожидания продолжает копиться
        else буфер полон
          BUF --> DV : False
          DV ->> ST : POST /webhooks/reject(bid)
          note over DV,ST : техническая потеря, в штатном прогоне не возникает
        end
        DV -> DV : _release(worker) — IDLE или UNAVAILABLE, current_bid = None
      end
    end
  end
end

== Обработка заявки воркером (ПЗ1: t_обсл ~ Exp(1 / mean_service_time)) ==
W -> W : run(bid) — принять и десериализовать пакет
W -> W : _emulate_service() — выдержка по экспоненциальному закону
W -> DB : write(bid)
DB --> W : OK
W -> W : _is_anomaly(metrics)
opt обнаружена аномалия (длинный хвост ПЗ1)
  W -> PD : create_incident(bid, metric)
  PD --> W : incidentId
end

== Триггер Б2: воркер освободился ==
W -> DV : POST /update-status(worker_id, task_id, IDLE, t_service)
DV -> DV : on_worker_free() — сверка task_id, bid = worker.current_bid
note over DV : запоздавший ответ со старым task_id игнорируется
DV -> DV : worker.status = IDLE, current_bid = None, started_at = None
DV ->> ST : POST /task-status(bid, done, worker_id, slot, t_обсл = t_service, at)
note over ST : add_wait, add_service, add_busy, mark_end(at)
DV --> W : 200 OK
DV -> DV : _try_dispatch()
note over DV,BUF : заявка, ждавшая в буфере, уходит на освободившегося воркера

== Watchdog ==
loop каждые watchdog_interval секунд
  DV -> DV : watchdog() → _reclaim_stale()
  opt воркер BUSY дольше task_timeout (завис или упал)
    DV -> BUF : requeue(current_bid)
    opt буфер полон
      DV ->> ST : POST /webhooks/reject(bid)
    end
    DV -> DV : worker.status = UNAVAILABLE, current_bid = None
  end
  DV -> DV : _try_dispatch() (страховка от потери buffer_updated: Pub/Sub не гарантирует доставку)
end

== Чтение результатов (ОР1, ОД3) ==
OP -> ST : GET /summary
ST --> OP : Summary (таблица 1 по источникам, таблица 2 по воркерам, total_time)
note over ST : total_time = mark_end − mark_start — общее время реализации для K_исп
OP -> ST : GET /precision
ST --> OP : PrecisionReport(required_n, generated, reached)
OP -> ST : GET /timeline
ST --> OP : list<TimelineEvent> (at, kind, source_name, seq, bid_id, slot, worker_id)
@enduml
