@startuml service_classes_diagram
title Диаграмма классов сервиса сбора метрик

skinparam shadowing false
skinparam classAttributeIconSize 0
left to right direction

namespace Agent {
    class AgentConfig {
        +str server_name
        +str server_type
        +int timeout_min
        +int timeout_max
        +str reception_service_url
    }
    class MetricsExporter {
        -str _server_name
        -str _server_type
        -int _measuring_count
        -int _seq
        +get_cpu_load() float
        +get_ram_load() float
        +get_disk_read() int
        +get_disk_write() int
        +get_la() list<float>
        +collect() ServerStats
    }
    class PollingManager {
        -Client _client
        -MetricsExporter _exporter
        -int _timeout_min
        -int _timeout_max
        +polling() None
    }
    class Client {
        -str _url
        -str _POST_ENDPOINT
        +send_metrics(metrics: ServerStats) None
    }
}

namespace Common {
    class Metrics <<dataclass>> {
        +float cpu_load
        +float ram_load
        +int disk_read
        +int disk_write
        +list<float> load_average
        +datetime timestamp
    }
    class ServerStats <<dataclass>> {
        +str server_name
        +str server_type
        +int seq
        +Metrics metrics
    }
    class Bid <<dataclass>> {
        +Optional<int> id
        +str source_name
        +str source_type
        +datetime time_in
        +Metrics stats
    }
    class PutResult <<dataclass>> {
        +bool accepted
        +int bid_id
        +int seq
        +Optional<int> slot
    }
    class TakeResult <<dataclass>> {
        +Bid bid
        +int slot
    }
}

namespace ReceptionService {
    class ReceptionApp <<FastAPI>> {
        +collect_metrics(stats: ServerStatsDTO, buffer: Buffer, stats_client: ReceptionStatsClient) None
        +lifespan(app: FastAPI) None
        +get_buffer(request: Request) Buffer
        +create_buffer() Buffer
    }
    class ReceptionConfig {
        +BufferTypes buffer_type
        +str redis_url
        +int buffer_capacity
        +str stats_server_url
    }
    class ReceptionStatsClient {
        -str _stats_server_url
        -str _NEW_WEBHOOK_ENDPOINT
        -str _REJECTED_WEBHOOK_ENDPOINT
        +notify(notification_type: str, bid: Bid, result: PutResult) None
    }
}

namespace BufferLib {
    abstract class Buffer {
        +put(bid: Bid, seq: int) PutResult
        +get_free_space() int
        +pull() TakeResult
        +requeue(bid: Bid) bool
        +subscribe(callback) None
        +ping() None
        +aclose() None
    }
    class RedisBuffer {
        -Redis _redis
        -int _capacity
        -str _SLOTS_KEY
        -str _ID_KEY
        -str _CHANNEL
        -Script _put_script
        -Script _return_script
        -Script _take_next_script
        +put(bid: Bid, seq: int) PutResult
        +get_free_space() int
        +pull() TakeResult
        +requeue(bid: Bid) bool
        +subscribe(callback) None
        +ping() None
        +aclose() None
        -_load_script(name: str) str
        -_register_scripts(redis_client: Redis) tuple
    }
}

class RedisServer <<Redis + Lua>> {
    buffer:slots : hash слот → конверт (id, prio, payload), не больше buffer_capacity мест
    buffer:bid_id : глобальный счётчик id заявок
    put_bid : атомарно INCR id (seq Redis не считает и не хранит), затем Д1ОЗ3 первое свободное место от начала, PUBLISH buffer_updated
    take_next : Д2Б4 приоритет prio по source_type, при равных max(id), слот освобождается
    return_bid : возврат заявки на первое свободное место, id и payload сохраняются, без PUBLISH
    buffer_updated : Pub/Sub канал
}

namespace WorkerDispatcher {
    class DispatcherApp <<FastAPI>> {
        +register(worker_id: int, url: str, priority: int, manager: WorkerManager) None
        +update_status(worker_id: int, task_id: int, status: WorkerStatus, t_service: float, manager: WorkerManager) None
    }
    class DispatcherConfig {
        +BufferTypes buffer_type
        +str redis_url
        +int buffer_capacity
        +str stats_server_url
        +float watchdog_interval
        +float task_timeout
    }
    class WorkerManager {
        -list<WorkerClient> _workers
        -Buffer _buffer
        -DispatcherStatsClient _stats_client
        -Lock _lock
        -float _watchdog_interval
        -float _task_timeout
        +add_worker(worker: WorkerClient) None
        +on_buffer_updated() None
        +on_worker_free(worker_id: int, task_id: int, t_service: float) None
        +watchdog() None
        -_try_dispatch() None
        -_get_worker() WorkerClient
        -_release(worker: WorkerClient, available: bool) None
        -_reclaim_stale() None
    }
    class WorkerClient {
        +int id
        +int priority
        +WorkerStatus status
        +Bid current_bid
        +datetime started_at
        -str _url
        +push(bid: Bid) bool
    }
    class WorkerStatus <<enumeration>> {
        IDLE
        BUSY
        UNAVAILABLE
    }
    class DispatcherStatsClient {
        -str _stats_server_url
        -str _TASK_STATUS_ENDPOINT
        -str _REJECT_WEBHOOK_ENDPOINT
        +send_task_status(bid: Bid, status: str, worker_id: int, slot: int, duration: float, at: datetime) None
        +send_reject(bid: Bid) None
    }
}

namespace WorkerService {
    class WorkerConfig {
        +int worker_id
        +int priority
        +float mean_service_time
        +float anomaly_prob
        +str dispatcher_url
        +str db_url
        +str pagerduty_url
    }
    class WorkerApp <<FastAPI>> {
        +startup(config: WorkerConfig, worker: Worker) None
        +process(bid: Bid) None
    }
    class Worker {
        -int _id
        -str _dispatcher_url
        -float _mean_service_time
        -float _anomaly_prob
        -bool _busy
        -TimeSeriesDbClient _db
        -AlertClient _alerts
        +register(priority: int) None
        +run(bid: Bid) None
        -_emulate_service() float
        -_is_anomaly(metrics: Metrics) bool
        -_report_idle(task_id: int, t_service: float) None
    }
    class TimeSeriesDbClient {
        -str _db_url
        +write(bid: Bid) None
    }
    class AlertClient {
        -str _pagerduty_url
        +create_incident(bid: Bid, metric: str) str
    }
}

namespace StatisticsService {
    class StatsApp <<FastAPI>> {
        +on_new(event: NewEvent, c: StatsCollector) None
        +on_reject(event: RejectEvent, c: StatsCollector) None
        +on_task_status(event: TaskStatusEvent, c: StatsCollector) None
        +summary(c: StatsCollector) Summary
        +precision(c: StatsCollector) PrecisionReport
        +timeline(c: StatsCollector) list<TimelineEvent>
        +reset(c: StatsCollector) None
    }
    class StatsConfig {
        +float confidence_t
        +float rel_precision
    }
    class StatsCollector {
        -dict<str, SourceStats> _sources
        -dict<int, WorkerStats> _workers
        -dict<int, int> _seq_by_bid
        -EventLog _timeline
        -PrecisionChecker _precision
        -datetime _t_start
        -datetime _t_end
        +on_new(event: NewEvent) None
        +on_reject(event: RejectEvent) None
        +on_taken(event: TaskStatusEvent) None
        +on_done(event: TaskStatusEvent) None
        +mark_start(at: datetime) None
        +mark_end(at: datetime) None
        +total_time() float
        +summary() Summary
        +precision() PrecisionReport
        +reset() None
        -_seq_of(bid_id: int, known: Optional<int>) int
    }
    class SourceStats {
        -int _generated
        -int _rejected
        -RunningStat _wait
        -RunningStat _service
        +add_new() None
        +add_reject() None
        +add_wait(t: float) None
        +add_service(t: float) None
        +row(source_name: str, source_type: str) SourceRow
    }
    class WorkerStats {
        +int worker_id
        -float _busy_time
        +add_busy(t_service: float) None
        +row(total_time: float) WorkerRow
    }
    class RunningStat {
        -int _n
        -float _mean
        -float _m2
        +add(x: float) None
        +mean() float
        +variance() float
    }
    class EventLog {
        -list<TimelineEvent> _events
        +append(ev: TimelineEvent) None
        +all() list<TimelineEvent>
        +clear() None
    }
    class PrecisionChecker {
        -float _t
        -float _delta
        +required_n(p_reject: float) int
        +check(generated: int, p_reject: float) PrecisionReport
    }
    class NewEvent <<BaseModel>> {
        +Bid bid
        +int seq
        +Optional<int> slot
    }
    class RejectEvent <<BaseModel>> {
        +Bid bid
        +Optional<int> seq
    }
    class TaskStatusEvent <<BaseModel>> {
        +Bid bid
        +str status
        +int worker_id
        +Optional<int> slot
        +float duration
        +datetime at
    }
    class TimelineEvent <<dataclass>> {
        +datetime at
        +str kind
        +str source_name
        +str source_type
        +int bid_id
        +int seq
        +Optional<int> slot
        +Optional<int> worker_id
    }
    class SourceRow <<dataclass>> {
        +str source_name
        +str source_type
        +int generated
        +float p_reject
        +float t_total
        +float t_wait
        +float t_service
        +float d_wait
        +float d_service
    }
    class WorkerRow <<dataclass>> {
        +int worker_id
        +float utilization
    }
    class Summary <<dataclass>> {
        +list<SourceRow> sources
        +list<WorkerRow> workers
        +float total_time
    }
    class PrecisionReport <<dataclass>> {
        +int required_n
        +int generated
        +bool reached
    }
}

' Agent
AgentConfig ..> MetricsExporter : server_name, server_type
AgentConfig ..> PollingManager : timeout_min, timeout_max
AgentConfig ..> Client : reception_service_url
PollingManager --> MetricsExporter : _exporter, запрос метрик от ОС
PollingManager --> Client : _client, ServerStats
Client ..> PollingManager : Exception при ошибках сети
MetricsExporter ..> ServerStats : создаёт, номер seq берёт из _seq
ServerStats *-- Metrics
Client ..> ReceptionApp : HTTP POST /collect

' Reception service
ReceptionApp ..> Buffer : Depends(get_buffer), put(bid, seq)
ReceptionApp ..> ReceptionStatsClient : Depends(get_stats), notify(type, bid, PutResult)
ReceptionApp ..> Bid : создаёт без id, затем записывает id из PutResult
ReceptionConfig ..> RedisBuffer : buffer_type, redis_url, buffer_capacity (create_buffer)
ReceptionConfig ..> ReceptionStatsClient : stats_server_url
Buffer ..> PutResult : возвращает
ReceptionStatsClient ..> PutResult : seq и slot для вебхука new
RedisBuffer ..|> Buffer : реализует
RedisBuffer ..> RedisServer : EVAL put_bid, take_next, return_bid и SUBSCRIBE buffer_updated
Bid *-- Metrics

' Worker dispatcher
DispatcherApp ..> WorkerManager : Depends(get_manager)
DispatcherConfig ..> RedisBuffer : buffer_type, redis_url, buffer_capacity
DispatcherConfig ..> DispatcherStatsClient : stats_server_url
DispatcherConfig ..> WorkerManager : watchdog_interval, task_timeout
WorkerManager --> Buffer : _buffer
WorkerManager --> DispatcherStatsClient : _stats_client
WorkerManager o-- WorkerClient : _workers
WorkerClient --> WorkerStatus : status
WorkerClient ..> Bid : current_bid
Buffer ..> TakeResult : возвращает
RedisServer ..> RedisBuffer : Pub/Sub buffer_updated

' Worker
WorkerClient ..> WorkerApp : POST /process, bool по 202 или 409 и ошибке
WorkerConfig ..> WorkerApp : worker_id, priority, dispatcher_url
WorkerConfig ..> Worker : mean_service_time для ПЗ1, anomaly_prob
WorkerConfig ..> TimeSeriesDbClient : db_url
WorkerConfig ..> AlertClient : pagerduty_url
WorkerApp ..> Worker : run(bid), 202 Accepted или 409 Busy
Worker --> TimeSeriesDbClient : _db
Worker --> AlertClient : _alerts
Worker ..> DispatcherApp : POST /register, POST /update-status (IDLE, task_id, t_service)

' Statistics service
ReceptionStatsClient ..> StatsApp : POST /webhooks/new, /webhooks/reject
DispatcherStatsClient ..> StatsApp : POST /task-status, /webhooks/reject
StatsApp ..> StatsCollector : Depends(get_collector)
StatsApp ..> NewEvent
StatsApp ..> RejectEvent
StatsApp ..> TaskStatusEvent
StatsCollector o-- SourceStats : _sources
StatsCollector o-- WorkerStats : _workers
StatsCollector *-- EventLog : _timeline
StatsCollector *-- PrecisionChecker : _precision
StatsCollector ..> TimelineEvent : append в _timeline
StatsCollector ..> Summary : summary()
StatsCollector ..> PrecisionReport : precision()
StatsConfig ..> PrecisionChecker : confidence_t, rel_precision
SourceStats *-- RunningStat : _wait, _service
SourceStats ..> SourceRow : row()
WorkerStats ..> WorkerRow : row(total_time)
EventLog o-- TimelineEvent
Summary o-- SourceRow
Summary o-- WorkerRow
NewEvent --> Bid
RejectEvent --> Bid
TaskStatusEvent --> Bid
TakeResult --> Bid

@enduml
