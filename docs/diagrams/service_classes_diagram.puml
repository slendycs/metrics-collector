@startuml service_classes_diagram
title Диаграмма классов — Сервис сбора метрик (вариант 27)
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Common (libs/models)" {
  enum ServerTypes { PRODUCTION\nSTAGING\nTEST }
  enum LogLevel { DEBUG\nINFO\nWARNING\nERROR\nCRITICAL }
  enum BufferTypes { REDIS }
  class Metrics <<dataclass>> {
    +cpu_load: float
    +ram_load: float
    +disk_read: int
    +disk_write: int
    +load_average: list<float>
    +timestamp: datetime
  }
  class ServerStats <<dataclass>> {
    +server_name: str
    +server_type: ServerTypes
    +seq: int
    +metrics: Metrics
  }
  class Bid <<dataclass>> {
    +source_name: str
    +source_type: ServerTypes
    +time_in: datetime
    +stats: Metrics
    +id: Optional<int>
  }
  class PutResult <<dataclass>> {
    +accepted: bool
    +bid_id: int
    +seq: int
    +source_name: str
    +source_type: ServerTypes
    +slot: Optional<int>
  }
  class TakeResult <<dataclass>> {
    +bid: Bid
    +slot: int
  }
  class MetricsDTO <<BaseModel>> {
    +cpu_load: float
    +ram_load: float
    +disk_read: int
    +disk_write: int
    +load_average: list<float>
    +timestamp: datetime
    +to_obj(): Metrics
  }
  class ServerStatsDTO <<BaseModel>> {
    +server_name: str
    +server_type: ServerTypes
    +seq: int
    +metrics: MetricsDTO
    +to_obj(): ServerStats
  }
  class BidDTO <<BaseModel>> {
    +source_name: str
    +source_type: ServerTypes
    +time_in: datetime
    +stats: MetricsDTO
    +to_obj(bid_id: Optional<int>): Bid
  }
  class PutResultDTO <<BaseModel>> {
    +accepted: bool
    +bid_id: int
    +seq: int
    +source_name: str
    +source_type: ServerTypes
    +slot: Optional<int>
  }
  ServerStats *-- Metrics
  ServerStats --> ServerTypes
  Bid *-- Metrics
  Bid --> ServerTypes
  PutResult --> ServerTypes
  TakeResult o-- Bid
  ServerStatsDTO *-- MetricsDTO
  BidDTO *-- MetricsDTO
  ServerStatsDTO ..> ServerStats : <<create>>
  BidDTO ..> Bid : <<create>>
  MetricsDTO ..> Metrics : <<create>>
  PutResultDTO ..> PutResult : <<from_attributes>>
}

package "Agent" {
  class Config { +server_name: str\n+server_type: ServerTypes\n+timeout_min: int\n+timeout_max: int\n+reception_service_url: str\n+log_level: LogLevel }
  class MetricsExporter {
    -_interval: float
    -_seq: int
    -_read_disk_bytes(): tuple<int,int>
    +collect(): ServerStats
  }
  class PoolingManager {
    -_client: Client
    -_exporter: MetricsExporter
    +pooling(): None
  }
  class Client {
    -_POST_ENDPOINT: str
    +post(server_stats: ServerStats): None
  }
  PoolingManager --> MetricsExporter
  PoolingManager --> Client
  Config ..> PoolingManager
  Config ..> MetricsExporter
  Config ..> Client
  MetricsExporter ..> ServerStats : <<create>>
}

package "BufferLib (libs/buffer)" {
  abstract class Buffer {
    {abstract} +put(bid: Bid, seq: int): PutResult
    {abstract} +ping(): None
    {abstract} +aclose(): None
    ..планируется для ДВ (ещё не реализовано в libs/buffer)..
    {abstract} +pull(): Optional<TakeResult>
    {abstract} +requeue(bid: Bid): bool
    {abstract} +subscribe(callback): None
  }
  class RedisBuffer {
    -_redis: Redis
    -_capacity: int
    -_SLOTS_KEY: str
    -_ID_KEY: str
    -_CHANNEL: str
    -_put_script: Script
    -_return_script: Script
    -_take_next_script: Script
    +__init__(redis_client: Redis, capacity: int)
    +put(bid: Bid, seq: int): PutResult
    +ping(): None
    +aclose(): None
    -_load_script(name: str): str
    -_register_scripts(redis_client: Redis): tuple
  }
  class BufferException { +error_msg: str }
  class BufferTimeoutError
  class BufferConnectionError
  class BufferResponseError
  class RedisServer <<Redis + Lua>> {
    buffer:slots, buffer:bid_id
    put_bid (Д1ОЗ3, Д1ОО5, PUBLISH при accepted)
    take_next (Д2Б4)
    return_bid
    buffer_updated (Pub/Sub)
  }
  Buffer <|.. RedisBuffer
  RedisBuffer ..> RedisServer : EVALSHA, SUBSCRIBE
  RedisBuffer ..> BidDTO : model_validate(bid)
  RedisBuffer ..> BufferException : <<throws>>
  BufferException <|-- BufferTimeoutError
  BufferException <|-- BufferConnectionError
  BufferException <|-- BufferResponseError
  Buffer ..> PutResult
  Buffer ..> TakeResult
}

package "ReceptionService (apps/intake)" {
  class "Settings" as ReceptionSettings <<BaseSettings>> {
    +buffer_type: BufferTypes
    +buffer_capacity: int
    +redis_url: Optional<str>
    +stats_server_url: str
    +log_level: LogLevel
    +check_redis_link(): Self
  }
  class "FastAPI app\n(main.py, routes)" as ReceptionApp <<FastAPI>> {
    +lifespan(app): None
    +collect_metrics(stats: ServerStatsDTO, buffer: Buffer): PutResultDTO
    +health(): int
    +create_buffer(): Buffer
    +get_buffer(request): Buffer
  }
  class "StatsClient" as ReceptionStatsClient {
    -_STATS_ENDPOINT: str
    +notify(post_result: PutResult): None
  }
  ReceptionSettings ..> ReceptionApp : buffer_type, buffer_capacity, redis_url
  ReceptionSettings ..> ReceptionStatsClient : stats_server_url
  ReceptionApp --> Buffer : app.state.buffer\n(lifespan: create_buffer, ping, aclose)
  ReceptionApp ..> RedisBuffer : <<create>> (DI)
  ReceptionApp ..> ServerStatsDTO : тело POST /collect
  ReceptionApp ..> Bid : <<create>>
  ReceptionApp ..> PutResultDTO : ответ 201
  ReceptionApp ..> ReceptionStatsClient : <<create>> на каждый запрос,\nнотификация после put
  ReceptionStatsClient ..> PutResult
  ReceptionStatsClient ..> PutResultDTO : model_validate
}

package "WorkerDispatcher" {
  class DispatcherSettings <<BaseSettings>> {
    +buffer_type: BufferTypes
    +buffer_capacity: int
    +redis_url: Optional<str>
    +stats_server_url: str
    +watchdog_interval: float
    +task_timeout: float
  }
  class DispatcherApp <<FastAPI>> {
    +lifespan(app): None
    +register(worker_id: int, url: str, priority: int, manager: WorkerManager): None
    +update_status(worker_id: int, task_id: int, status: WorkerStatus, t_service: float, manager: WorkerManager): None
  }
  class WorkerManager {
    -_workers: list<WorkerClient>
    -_buffer: Buffer
    -_stats_client: DispatcherStatsClient
    -_lock: Lock
    -_watchdog_interval: float
    -_task_timeout: float
    +add_worker(worker: WorkerClient): None
    +on_buffer_updated(): None
    +on_worker_free(worker_id: int, task_id: int, t_service: float): None
    +watchdog(): None
    -_try_dispatch(): None
    -_get_worker(): Optional<WorkerClient>
    -_release(worker: WorkerClient, available: bool): None
    -_reclaim_stale(): None
  }
  class WorkerClient {
    +id: int
    +priority: int
    +status: WorkerStatus
    +current_bid: Optional<Bid>
    +current_slot: Optional<int>
    +started_at: Optional<datetime>
    -_url: str
    +push(bid: Bid): bool
  }
  enum WorkerStatus { IDLE\nBUSY\nUNAVAILABLE }
  class DispatcherStatsClient {
    -_stats_server_url: str
    -_TASK_STATUS_ENDPOINT: str
    -_REJECT_WEBHOOK_ENDPOINT: str
    +send_task_status(bid: Bid, status: str, worker_id: int, slot: Optional<int>, duration: float, at: datetime): None
    +send_reject(bid: Bid): None
  }
  DispatcherSettings ..> WorkerManager
  DispatcherSettings ..> DispatcherStatsClient
  DispatcherApp ..> WorkerManager : Depends(get_manager)
  WorkerManager --> Buffer : _buffer (DI)
  WorkerManager --> DispatcherStatsClient : _stats_client
  WorkerManager o-- "0..*" WorkerClient : _workers
  WorkerClient --> WorkerStatus
  WorkerClient o-- Bid : current_bid
  Buffer ..> WorkerManager : <<callback>> on_buffer_updated
}

package "WorkerService" {
  class WorkerSettings <<BaseSettings>> {
    +worker_id: int
    +priority: int
    +mean_service_time: float
    +anomaly_prob: float
    +dispatcher_url: str
    +db_url: str
    +pagerduty_url: str
  }
  class WorkerApp <<FastAPI>> {
    +lifespan(app): None
    +process(bid: BidDTO, worker: Worker): None
  }
  class Worker {
    -_id: int
    -_dispatcher_url: str
    -_mean_service_time: float
    -_anomaly_prob: float
    -_busy: bool
    -_db: TimeSeriesDbClient
    -_alerts: AlertClient
    +register(priority: int): None
    +run(bid: Bid): None
    -_emulate_service(): float
    -_is_anomaly(metrics: Metrics): bool
    -_report_idle(task_id: int, t_service: float): None
  }
  class TimeSeriesDbClient { -_db_url: str\n+write(bid: Bid): None }
  class AlertClient { -_pagerduty_url: str\n+create_incident(bid: Bid, metric: str): str }
  WorkerSettings ..> WorkerApp
  WorkerApp ..> Worker : Depends(get_worker)
  Worker --> TimeSeriesDbClient : _db
  Worker --> AlertClient : _alerts
  WorkerClient ..> WorkerApp : POST /process (202 / 409)
  Worker ..> DispatcherApp : POST /register, /update-status
}

package "StatisticsService" {
  class StatsSettings <<BaseSettings>> { +confidence_t: float\n+rel_precision: float }
  class StatsApp <<FastAPI>> {
    +on_put(result: PutResultDTO, c: StatsCollector): None
    +on_reject(event: RejectEvent, c: StatsCollector): None
    +on_task_status(event: TaskStatusEvent, c: StatsCollector): None
    +summary(c: StatsCollector): Summary
    +precision(c: StatsCollector): PrecisionReport
    +timeline(c: StatsCollector): list<TimelineEvent>
    +reset(c: StatsCollector): None
  }
  class StatsCollector {
    -_sources: dict<str, SourceStats>
    -_workers: dict<int, WorkerStats>
    -_seq_by_bid: dict<int, int>
    -_timeline: EventLog
    -_precision: PrecisionChecker
    -_t_start: datetime
    -_t_end: datetime
    +on_put(result: PutResultDTO): None
    +on_reject(event: RejectEvent): None
    +on_taken(event: TaskStatusEvent): None
    +on_done(event: TaskStatusEvent): None
    +mark_start(at: datetime): None
    +mark_end(at: datetime): None
    +total_time(): float
    +summary(): Summary
    +precision(): PrecisionReport
    +reset(): None
    -_seq_of(bid_id: int, known: Optional<int>): int
  }
  class SourceStats {
    -_generated: int
    -_rejected: int
    -_wait: RunningStat
    -_service: RunningStat
    +add_new(): None
    +add_reject(): None
    +add_wait(t: float): None
    +add_service(t: float): None
    +row(source_name: str, source_type: str): SourceRow
  }
  class WorkerStats { +worker_id: int\n-_busy_time: float\n+add_busy(t_service: float): None\n+row(total_time: float): WorkerRow }
  class RunningStat { -_n: int\n-_mean: float\n-_m2: float\n+add(x: float): None\n+mean(): float\n+variance(): float }
  class EventLog { -_events: list<TimelineEvent>\n+append(ev: TimelineEvent): None\n+all(): list<TimelineEvent>\n+clear(): None }
  class PrecisionChecker { -_t: float\n-_delta: float\n+required_n(p_reject: float): int\n+check(generated: int, p_reject: float): PrecisionReport }
  class RejectEvent <<BaseModel>> { +bid: BidDTO\n+seq: Optional<int> }
  class TaskStatusEvent <<BaseModel>> { +bid: BidDTO\n+status: str\n+worker_id: int\n+slot: Optional<int>\n+duration: float\n+at: datetime }
  class TimelineEvent <<dataclass>> { +at: datetime\n+kind: str\n+source_name: str\n+source_type: str\n+bid_id: int\n+seq: int\n+slot: Optional<int>\n+worker_id: Optional<int> }
  class SourceRow <<dataclass>> { +source_name: str\n+source_type: str\n+generated: int\n+p_reject: float\n+t_total: float\n+t_wait: float\n+t_service: float\n+d_wait: float\n+d_service: float }
  class WorkerRow <<dataclass>> { +worker_id: int\n+utilization: float }
  class Summary <<dataclass>> { +sources: list<SourceRow>\n+workers: list<WorkerRow>\n+total_time: float }
  class PrecisionReport <<dataclass>> { +required_n: int\n+generated: int\n+reached: bool }
  StatsSettings ..> PrecisionChecker
  StatsApp ..> StatsCollector : Depends(get_collector)
  StatsApp ..> PutResultDTO : POST /intake/take
  StatsApp ..> RejectEvent
  StatsApp ..> TaskStatusEvent
  StatsCollector o-- "0..*" SourceStats : _sources
  StatsCollector o-- "0..*" WorkerStats : _workers
  StatsCollector *-- EventLog : _timeline
  StatsCollector *-- PrecisionChecker : _precision
  StatsCollector ..> Summary
  StatsCollector ..> PrecisionReport
  SourceStats *-- RunningStat : _wait, _service
  SourceStats ..> SourceRow
  WorkerStats ..> WorkerRow
  EventLog o-- TimelineEvent
  Summary o-- SourceRow
  Summary o-- WorkerRow
  PrecisionChecker ..> PrecisionReport
  RejectEvent --> BidDTO
  TaskStatusEvent --> BidDTO
  ReceptionStatsClient ..> StatsApp : POST /intake/take
  DispatcherStatsClient ..> StatsApp : POST /task-status, /webhooks/reject
}

Client ..> ReceptionApp : POST /collect
@enduml
