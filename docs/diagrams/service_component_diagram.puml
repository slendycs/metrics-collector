@startuml service_component_diagram
title Диаграмма компонентов — Сервис сбора метрик (вариант 27)
left to right direction
skinparam componentStyle uml2

package "Пул агентов (ИБ, ИЗ2)" {
  component "Агент\nприоритет 1 (production)" as A1
  component "Агент\nприоритет 2 (staging)" as A2
  component "Агент\nприоритет 3 (test)" as A3
}

component "Сервис приёма (ДП)\napps/intake" as DP
interface "POST /collect\nGET /health" as ICollect

component "Буфер (Д1ОЗ3, Д1ОО5, Д2Б4)\nlibs/buffer: Buffer ← RedisBuffer" as BUF
database "Redis + Lua\nput_bid / take_next / return_bid\nPub/Sub buffer_updated" as REDIS

component "Сервис управления воркерами (ДВ, Д2П1)\nWorkerManager" as DV
interface "POST /register\nPOST /update-status" as IDisp

package "Пул воркеров (П31, ПЗ1)" {
  component "Воркер 1\nприоритет 1" as W1
  component "Воркер 2\nприоритет 2" as W2
  component "Воркер 3\nприоритет 3" as W3
}
interface "POST /process" as IProc

component "Сервис статистики (ОР1, ОД3)" as ST
interface "POST /intake/take\nPOST /webhooks/reject\nPOST /task-status" as IStat
interface "GET /summary\nGET /precision\nGET /timeline" as IRep

database "БД временных рядов" as TSDB
cloud "PagerDuty" as PD
actor "Оператор" as OP

A1 -( ICollect
A2 -( ICollect
A3 -( ICollect
ICollect - DP

DP ..> BUF : <<use>> put(bid, seq), ping()\n(DI: Buffer)
BUF ..> REDIS : EVALSHA, PUBLISH
DV ..> BUF : <<use>> pull / requeue / subscribe\n(DI: Buffer)
BUF ..> DV : <<callback>> on_buffer_updated

DV - IDisp
W1 -( IDisp
W2 -( IDisp
W3 -( IDisp

DV -( IProc
IProc - W1
IProc - W2
IProc - W3

W1 ..> TSDB : write
W2 ..> TSDB : write
W3 ..> TSDB : write
W1 ..> PD : create_incident
W2 ..> PD : create_incident
W3 ..> PD : create_incident

DP -( IStat : PutResultDTO\n(accepted, bid_id, seq, slot)
DV -( IStat
IStat - ST
ST - IRep
OP -( IRep

note bottom of BUF
  Буфер подключается через DI:
  Settings.buffer_type → create_buffer()
  → RedisBuffer(redis_client, capacity)
  (создаётся в lifespan, ping() при старте)
end note
@enduml
